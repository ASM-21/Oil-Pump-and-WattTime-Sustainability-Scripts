# Copy this file to .env for local work. Do not commit .env.

# WattTime API credentials used by Background watttime scripts/ and WattTime Analysis Folder/.
WATTTIME_USERNAME=your_watttime_username
WATTTIME_PASSWORD=your_watttime_password

# Optional local paths for analysis data that should not be committed.
WATTTIME_LIBRARY_DIR=/path/to/local/watttime_library
WATTTIME_RUNS_DIR=/path/to/local/watttime_runs

# OpenLCA IPC settings used by openLCA Automation/ and openlca-mcp/.
OPENLCA_SERVER_URL=http://localhost:8080
OPENLCA_IPC_PORT=8081
OPENLCA_PROCESS_ID=replace-with-local-process-uuid
OPENLCA_PRODUCT_SYSTEM_ID=replace-with-local-product-system-uuid
OPENLCA_LCIA_METHOD_ID=replace-with-local-impact-method-uuid

# Optional local OpenNX output paths. Siemens NX/NXOpen is installed outside this repo.
OPENNX_MATERIAL_LIBRARY=/path/to/aluminum_expanded.xlsx
OPENNX_OUTPUT_DIR=/path/to/cad_energy_output
